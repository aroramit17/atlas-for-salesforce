{
  "manifest_version": 3,
  "name": "Atlas for Salesforce",
  "short_name": "Atlas",
  "description": "Salesforce record, query, CSV, schema, code, org, and API tools in one side panel.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage", "tabs", "sidePanel"],
  "host_permissions": ["https://*.salesforce.com/*", "https://*.force.com/*"],
  "action": { "default_title": "Open Atlas for Salesforce" },
  "side_panel": { "default_path": "src/ui/panel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://*.salesforce.com/*", "https://*.force.com/*"],
    "js": ["src/content/org-mark.js"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
